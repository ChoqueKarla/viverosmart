generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Plant {
  id              Int              @id @default(autoincrement())
  name            String
  species         String
  createdAt       DateTime         @default(now())
  lat             Float
  lng             Float
  sectorId        Int?
  userId          Int?
  dailyReports    DailyReport[]
  sector          Sector?          @relation(fields: [sectorId], references: [id], onDelete: Cascade)
  user            User?            @relation(fields: [userId], references: [id], onDelete: Cascade)
  recommendations Recommendation[]
  soilStates      SoilState[]
  weatherStates   WeatherState[]
}

model SoilState {
  id                 Int      @id @default(autoincrement())
  plantId            Int
  moisturePercentage Float
  state              String
  timestamp          DateTime @default(now())
  plant              Plant    @relation(fields: [plantId], references: [id], onDelete: Cascade)
}

model WeatherState {
  id        Int      @id @default(autoincrement())
  plantId   Int
  state     String
  timestamp DateTime @default(now())
  plant     Plant    @relation(fields: [plantId], references: [id], onDelete: Cascade)
}

model Recommendation {
  id           Int      @id @default(autoincrement())
  plantId      Int
  message      String
  urgencyLevel String
  timestamp    DateTime @default(now())
  plant        Plant    @relation(fields: [plantId], references: [id], onDelete: Cascade)
}

model DailyReport {
  id           Int      @id @default(autoincrement())
  plantId      Int
  date         DateTime @default(now())
  waterSummary String
  lightSummary String
  jsonContent  String
  createdAt    DateTime @default(now())
  plant        Plant    @relation(fields: [plantId], references: [id], onDelete: Cascade)
}

model Role {
  id          Int              @id @default(autoincrement())
  name        String           @unique
  permissions RolePermission[]
  users       User[]
}

model Permission {
  id          Int              @id @default(autoincrement())
  code        String           @unique
  description String
  roles       RolePermission[]
}

model RolePermission {
  roleId       Int
  permissionId Int
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model User {
  id              Int                  @id @default(autoincrement())
  name            String
  email           String               @unique
  password        String
  roleId          Int
  auditLogs       AuditLog[]
  crops           Crop[]
  resetTokens     PasswordResetToken[]
  simulatorPlants Plant[]
  sectors         Sector[]             @relation("SectorClient")
  role            Role                 @relation(fields: [roleId], references: [id])
}

model PasswordResetToken {
  id        Int       @id @default(autoincrement())
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  userId    Int
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Sector {
  id           Int                  @id @default(autoincrement())
  name         String               @unique
  description  String?
  userId       Int?
  alerts       Alert[]
  consumptions Consumption[]
  anomalies    ConsumptionAnomaly[]
  crops        Crop[]
  plants       Plant[]
  schedules    Schedule[]
  user         User?                @relation("SectorClient", fields: [userId], references: [id])
  sensors      Sensor[]
  thresholds   Threshold[]
}

model Crop {
  id            Int     @id @default(autoincrement())
  name          String
  species       String?
  stage         String  @default("Semilla")
  growthPercent Int     @default(0)
  sectorId      Int
  userId        Int?
  sector        Sector  @relation(fields: [sectorId], references: [id], onDelete: Cascade)
  user          User?   @relation(fields: [userId], references: [id])
}

model Sensor {
  id           Int           @id @default(autoincrement())
  code         String        @unique
  type         String
  status       String        @default("ACTIVO")
  sectorId     Int
  consumptions Consumption[]
  sector       Sector        @relation(fields: [sectorId], references: [id], onDelete: Cascade)
}

model Consumption {
  id           Int                  @id @default(autoincrement())
  resourceType String
  quantity     Float
  isManual     Boolean              @default(false)
  timestamp    DateTime             @default(now())
  sectorId     Int
  sensorId     Int?
  sector       Sector               @relation(fields: [sectorId], references: [id], onDelete: Cascade)
  sensor       Sensor?              @relation(fields: [sensorId], references: [id])
  anomalies    ConsumptionAnomaly[]
}

model ConsumptionAnomaly {
  id            Int          @id @default(autoincrement())
  resourceType  String
  quantity      Float
  level         String
  reason        String
  timestamp     DateTime     @default(now())
  resolvedAt    DateTime?
  consumptionId Int?
  sectorId      Int
  consumption   Consumption? @relation(fields: [consumptionId], references: [id])
  sector        Sector       @relation(fields: [sectorId], references: [id], onDelete: Cascade)
}

model Threshold {
  id           Int     @id @default(autoincrement())
  resourceType String
  maxLimit     Float
  warningLimit Float?
  sectorId     Int?
  sector       Sector? @relation(fields: [sectorId], references: [id], onDelete: Cascade)

  @@unique([resourceType, sectorId])
}

model Alert {
  id           Int      @id @default(autoincrement())
  resourceType String
  level        String
  reason       String
  timestamp    DateTime @default(now())
  sectorId     Int
  sector       Sector   @relation(fields: [sectorId], references: [id], onDelete: Cascade)
}

model Schedule {
  id           Int       @id @default(autoincrement())
  type         String
  time         String
  durationMins Int
  date         DateTime?
  enabled      Boolean   @default(true)
  sectorId     Int
  sector       Sector    @relation(fields: [sectorId], references: [id], onDelete: Cascade)
}

model AuditLog {
  id        Int      @id @default(autoincrement())
  action    String
  details   String?
  timestamp DateTime @default(now())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}
